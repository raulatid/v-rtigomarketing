{
  "name": "vertigo-sanity-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The editorial Studio for vertigo-marketing-web. Deliberately its own package: nothing here may enter the application's dependency graph or its bundle.",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "typecheck": "tsc --noEmit",
    "import-fixtures": "node scripts/import-fixtures.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sanity": "^6.10.1",
    "styled-components": "^6.1.15"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3"
  }
}
