{
  "name": "vertigo-marketing-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/simulate-intro.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:intro": "node scripts/simulate-intro.mjs",
    "check:navigation": "esbuild checks/navigation-feel.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/navigation-feel.mjs --log-level=warning && node node_modules/.cache/navigation-feel.mjs",
    "check:district": "esbuild checks/district-flight.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/district-flight.mjs --log-level=warning && node node_modules/.cache/district-flight.mjs",
    "check": "npm run typecheck && npm run test:intro && npm run check:navigation && npm run check:district && npm run check:warp",
    "check:warp": "esbuild checks/warp-transition.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/warp-transition.mjs --log-level=warning && node node_modules/.cache/warp-transition.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.6.1",
    "gsap": "^3.12.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "stats.js": "^0.17.0",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/stats.js": "^0.17.4",
    "@types/three": "^0.174.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "potrace": "^2.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-glsl": "^1.3.3"
  }
}
