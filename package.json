{
  "name": "vertigo-marketing-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",

    "build": "npm run check && vite build",

    "check": "npm run typecheck && npm run test && npm run check:harnesses",
    "check:harnesses": "npm run check:architecture && npm run check:navigation && npm run check:zoom && npm run check:district && npm run check:warp && npm run check:space",
    "check:architecture": "esbuild checks/architecture.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/architecture.mjs --log-level=warning && node node_modules/.cache/architecture.mjs",
    "check:navigation": "esbuild checks/navigation-feel.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/navigation-feel.mjs --log-level=warning && node node_modules/.cache/navigation-feel.mjs",
    "check:zoom": "esbuild checks/navigation-zoom.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/navigation-zoom.mjs --log-level=warning && node node_modules/.cache/navigation-zoom.mjs",
    "check:district": "esbuild checks/district-flight.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/district-flight.mjs --log-level=warning && node node_modules/.cache/district-flight.mjs",
    "check:warp": "esbuild checks/warp-transition.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/warp-transition.mjs --log-level=warning && node node_modules/.cache/warp-transition.mjs",
    "check:space": "esbuild checks/space-backdrop.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/space-backdrop.mjs --log-level=warning && node node_modules/.cache/space-backdrop.mjs",
    "check:asset": "esbuild checks/city-asset.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/city-asset.mjs --log-level=warning && node node_modules/.cache/city-asset.mjs",

    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",

    "pree2e": "vite build",
    "e2e": "playwright test",
    "pree2e:update": "vite build",
    "e2e:update": "playwright test --update-snapshots",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@react-three/fiber": "^9.6.1",
    "gsap": "^3.12.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "stats.js": "^0.17.0",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/stats.js": "^0.17.4",
    "@types/three": "^0.174.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.21.5",
    "jsdom": "^29.1.1",
    "potrace": "^2.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-glsl": "^1.3.3",
    "vitest": "^3.2.7"
  }
}
