# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/

# Environment variables
#
# Every .env EXCEPT .env.example, rather than the usual three-line list: that
# list covered .env, .env.local and .env.*.local but not .env.production or
# .env.development, so a secret in either would have been committed silently.
# The form endpoints made some of them RUNTIME rather than build-time
# (RESEND_API_KEY above all), so the safe default is to ignore the lot and let
# .env.example be the documented exception.
.env
.env.*
!.env.example

# Vercel
.vercel/

# Code graph index (local tooling, machine-specific)
.codegraph/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cache
.cache/
.parcel-cache/
.vite/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Misc
*.local

# TypeScript incremental build info
*.tsbuildinfo

# Playwright run artifacts. The BASELINES under e2e/*-snapshots/ are committed
# deliberately — a baseline nobody can diff is not a baseline. These two are the
# per-run output: traces, failure screenshots and the HTML report.
/test-results/
/playwright-report/
/blob-report/

# Vitest coverage output.
/coverage/

# Generated content. BUILD OUTPUT, not source.
#
# WordPress is the editorial source of truth; these modules are written by
# `npm run content:build` before every dev run, check and build. Committing them
# would claim that a CMS edit produces a Git diff, which it does not — and the
# committed copy would go stale after the first CMS-triggered deployment while
# still looking authoritative.
#
# What IS committed: `content/fixtures/` (development and test inputs) and
# `content/seed/` (an explicitly-drifting emergency snapshot, see
# scripts/build-content.ts).
/src/content/generated/
# The generator's transactional staging directory (content/lib/generate.ts);
# a killed run would otherwise leave it behind as untracked noise.
/src/content/generated.tmp/

# Mirrored CMS media, written by the same build for the same reason.
/public/logos/*
!/public/logos/.gitkeep

# The Sanity Studio is its own package. Its dependencies and build output are
# not part of this application and must never reach its bundle; .out/ holds the
# NDJSON generated from content/fixtures/ for seeding a dataset.
#
# Its package-lock.json is COMMITTED, deliberately, and is not listed below. The
# Studio is deployed and the client edits in it, so its resolution has to be
# reproducible — and an npm audit result nobody can reproduce is a finding
# nobody can act on. See the Dependency audit section of sanity-studio/README.md.
/sanity-studio/node_modules/
/sanity-studio/dist/
/sanity-studio/.sanity/
/sanity-studio/.out/

# Sky-cubemap prototype faces (docs/plans/005). Six 4096^2 PNGs per variant is
# well over a hundred megabytes, and they are reproducible from the scene JSON
# in docs/plans/005-sky-cubemap/scenes/ — which is the actual deliverable.
/public/proto-sky/

# Candidate sky images being auditioned through ?skyImage=. Scratch files, often
# multi-megabyte PNGs straight off a download, and never a deliverable — the
# shipped sky is the four prepared files in public/textures/sky-panorama.*.
# The sky-test- prefix is enforced by protoSky.ts, so this cannot drift from it.
/public/textures/sky-test-*

# And the captures taken through them. 34 PNGs at 1600x900 and 3200x1800 is
# 25 MB, which is not weight a marketing site's repository should carry for the
# rest of its life — a clone pays for it forever, and the shots are regenerable
# from the scene JSON with scripts/proto/capture-sky-matrix.mjs.
#
# What IS committed is docs/plans/005-sky-cubemap/contact/: the same matrix at
# 640px WebP, about 1 MB, so the comparison stays reviewable in the repo. The
# two native-pixel crops live there too, deliberately un-resampled — downscaling
# them would throw away the texel-density evidence they were cut to show.
/docs/plans/005-sky-cubemap/shots/

# Split-plate hologram captures (docs/plans/007), for the same reason as the
# 005 shots above: nine PNGs at capture resolution is 57 MB, a clone pays for
# it forever, and every one of them is regenerable from the URL gate with
# scripts/proto/capture-holo.mjs. The inspection parameters are the deliverable
# — they live in the plan document, and in src/app/protoHolo.ts.
/docs/plans/007-split-plate/shots/

# Projection-field captures (docs/plans/008), regenerable the same way.
/docs/plans/008-projection-field/shots/
