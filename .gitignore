# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/

# Environment variables
#
# Every .env EXCEPT .env.example, rather than the usual three-line list: that
# list covered .env, .env.local and .env.*.local but not .env.production or
# .env.development, so a secret in either would have been committed silently.
# This project needs no runtime environment variables at all today — the only
# ones it reads are Vercel's own, at build time — so the safe default is to
# ignore the lot and let .env.example be the documented exception.
.env
.env.*
!.env.example

# Vercel
.vercel/

# Code graph index (local tooling, machine-specific)
.codegraph/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cache
.cache/
.parcel-cache/
.vite/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Misc
*.local

# TypeScript incremental build info
*.tsbuildinfo
