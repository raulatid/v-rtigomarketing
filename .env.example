# Environment variables this repository reads. ALL of them are BUILD-TIME —
# nothing in src/ reads import.meta.env, and no value here ever reaches the
# browser. Copy to `.env` for local experiments (every other .env* is ignored;
# this file is the documented exception). None of these is required locally:
# with nothing set, `npm run content:build` reads content/fixtures/ offline.
#
# Vercel: set the content variables under Settings → Environment Variables,
# scoped per environment as noted. Never use a VITE_ prefix for a credential —
# Vite compiles VITE_* into the public bundle.

# ── Content source (scripts/build-content.ts, ADR 010, ADR 011) ─────────────
# Sanity project id. Its presence selects the Sanity source.
#   Production: REQUIRED unless CONTENT_SOURCE=seed is set — a production build
#   with neither fails on purpose rather than shipping fixtures by omission.
#   Preview: optional (unset → fixtures, the client-demo content).
SANITY_PROJECT_ID=
# Sanity dataset, e.g. `production`. REQUIRED whenever the Sanity source is
# selected, in EVERY environment. Never defaulted: a guessed dataset is how a
# local build ends up reading the client's live content while looking offline.
SANITY_DATASET=
# Optional read-only token. Needed only if the dataset is private — published
# website content is already public, so a public dataset with no build token is
# the preferred arrangement (ADR 011). Drafts are excluded by the query, not by
# permissions. NEVER VITE_-prefixed.
SANITY_TOKEN=
# Per-request deadline in milliseconds (default 15000). Must be a positive
# number — an invalid value fails the build rather than falling back.
SANITY_TIMEOUT_MS=
# Force a source: sanity | fixture | seed. Overrides the default choice.
# `seed` builds from the committed content/seed/ snapshot, prints a banner, and
# exists only to ship a code-only change while the CMS is unavailable.
# The Sanity API version is NOT here: it decides response shape, so it is pinned
# in content/lib/sanity.ts and changes through a reviewed code change.
CONTENT_SOURCE=

# ── Build environment (vite.config.ts) ──────────────────────────────────────
# Local override to exercise the PRODUCTION path without Vercel: drops the
# debug console, emits robots.txt Allow + sitemap.xml, no noindex. On Vercel
# this is supplied as the system variable VERCEL_ENV — "Automatically expose
# System Environment Variables" MUST be enabled in the project; without it
# every deployment builds as development (debug console ships, robots says
# Disallow: /). VERCEL_PROJECT_PRODUCTION_URL (canonical / og:url / sitemap
# origin) comes from the same toggle.
VITE_VERCEL_ENV=

# ── Never set in any deployment ──────────────────────────────────────────────
# Escape hatch for inspecting a failing bundle locally. It disables BOTH chunk
# budgets AND the intro-standalone assertion in vite.config.ts.
# VERTIGO_SKIP_BUDGETS=1
